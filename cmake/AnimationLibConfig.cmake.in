#----------------------------------------
# AnimationLibConfig.cmake
#
# The package find_package(AnimationLib CONFIG) resolves. Consumers link the imported target
# AnimationLib::AnimationLib, which is the same name an in-repository add_subdirectory() build
# provides, so a consumer never has to know which route it got the library through.
#
# There is no find_dependency() call for the library itself, and that is deliberate rather than
# an omission: AnimationLib is pure standard C++23 with no required first-party dependencies.
# (Value.h offers a valuesEqual specialization for MathLib vector types behind __has_include,
# so MathLib is used when it happens to be on the include path and never required.)
#
# The one header that reaches outside AnimationLib is AnimationLib/SelfTest.h, the opt-in
# aggregator that registers the inline module self-tests with CoreLib's runner. It is the
# optional SelfTest component below, which a consumer asks for by name and nobody else pays for:
#
#   find_package(AnimationLib COMPONENTS SelfTest)
#   target_link_libraries(my_tests PRIVATE AnimationLib::SelfTest)
#----------------------------------------

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/AnimationLibTargets.cmake")

#----------------------------------------
# SelfTest component
#
# CoreLib is searched only when the component is actually requested, so an ordinary
# find_package(AnimationLib) never needs CoreLib present. QUIET plus an explicit _FOUND flag
# rather than find_dependency() on purpose: find_dependency aborts the whole package when the
# search fails, which is the wrong outcome for a component the caller may have listed as
# optional. Reporting the component as not-found instead lets check_required_components below
# decide — it fails the package for COMPONENTS, and passes it for OPTIONAL_COMPONENTS.
#----------------------------------------

if("SelfTest" IN_LIST AnimationLib_FIND_COMPONENTS)
	find_package(CoreLib CONFIG QUIET)

	if(TARGET CoreLib::CoreLib)
		if(NOT TARGET AnimationLib::SelfTest)
			add_library(AnimationLib::SelfTest INTERFACE IMPORTED)
			set_target_properties(AnimationLib::SelfTest PROPERTIES
				INTERFACE_LINK_LIBRARIES "AnimationLib::AnimationLib;CoreLib::CoreLib")
		endif()
		set(AnimationLib_SelfTest_FOUND TRUE)
	else()
		set(AnimationLib_SelfTest_FOUND FALSE)

		# The diagnostic has to be set at package level: check_required_components only propagates
		# AnimationLib_NOT_FOUND_MESSAGE, so a per-component message is silently dropped. Only set
		# when the component was required, so an OPTIONAL_COMPONENTS caller sees nothing.
		if(AnimationLib_FIND_REQUIRED_SelfTest)
			set(AnimationLib_NOT_FOUND_MESSAGE
				"AnimationLib's SelfTest component requires the CoreLib package (AnimationLib/SelfTest.h includes CoreLib/SelfTestRegistry.h). Add CoreLib's install prefix to CMAKE_PREFIX_PATH, or drop the SelfTest component.")
		endif()
	endif()
endif()

check_required_components(AnimationLib)
